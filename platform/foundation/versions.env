# The foundation images follow `latest` on ghcr.io (since Nov 18, 2026), so local work gets each
# new one at its next pull. A server never does: config/server/versions.env pins each by digest,
# and `make check` fails on a server image without one. Third-party images are pinned as
# tag@digest everywhere. A module pins its own image in modules/<id>/versions.env, and a project
# that must differ overrides a line in site/config/<layer>/versions.env, such as server/ or local/
# (site/versions.env comes before every layer, so it can't change a server's foundation pin).
# render.py merges every part's versions.env, then each layer's, later ones winning.

# Foundation, public on ghcr.io.
T10_AUTH_SERVER=ghcr.io/xiant10/auth-server:latest
T10_WORKBENCH=ghcr.io/xiant10/workbench:latest
T10_AGENT_TI=ghcr.io/xiant10/agent-ti:latest
T10_AGENTS=ghcr.io/xiant10/t10-agents:latest
T10_AI_GATEWAY=ghcr.io/xiant10/ai-gateway:latest
T10_KNOWLEDGE=ghcr.io/xiant10/t10-knowledge:latest
T10_AGENT_CONTROL=ghcr.io/xiant10/t10-agent-control:latest
T10_COLLAB=ghcr.io/xiant10/t10-collab:latest

# Components: assistant, automations, console, livekit.
T10_AGENT_PI=ghcr.io/xiant10/agent-pi:latest
T10_AUTOMATIONS=ghcr.io/xiant10/t10-automations:latest
T10_CONSOLE=ghcr.io/xiant10/t10-console:latest
T10_LIVEKIT_AGENT=ghcr.io/xiant10/t10-livekit-agent:latest

# t10-modkit, the Go module every module made here imports (github.com/xiant10/t10-modkit, public
# and tagged): new-module writes this tag into a module's go.mod, and make check warns on a module
# that requires an older one.
T10_MODKIT=v0.1.0

# Third party.
POSTGRES_IMAGE=postgres:17-alpine@sha256:526f86d93c6ea08fd3f1fe5605650cacc781b2c6013169a0ad8f42c7d3d84f32
# The TLS proxy on a server (dev, prod).
CADDY_IMAGE=caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
# The livekit component's media server. Pinned Nov 16 to the release `latest` was: make pin covers
# only ghcr.io, so bump this by hand.
LIVEKIT_IMAGE=livekit/livekit-server:v1.13.11@sha256:25cd902de7cacbd5f1f779f6a6ac1eae20ba8f56b0935934ce6b0ab80d1e3d20
