{
 "_comment": "The console component's secrets, as foundation/secrets.json.",
 "secrets": [
  {
   "name": "CONSOLE_CLIENT_SECRET",
   "generate": "hex32",
   "consumers": [
    "t10-console",
    "secret_sha256 in clients.yaml"
   ],
   "rotate": "Change, re-render clients.yaml, roll auth-server and t10-console together.",
   "rotation": "replace",
   "env": {
    "t10-console": {
     "AUTH_CLIENT_SECRET": "${CONSOLE_CLIENT_SECRET}"
    }
   }
  },
  {
   "name": "CONSOLE_SESSION_KEY",
   "generate": "b64key",
   "consumers": [
    "t10-console"
   ],
   "rotate": "Change and roll t10-console. Admins sign in again.",
   "rotation": "replace",
   "env": {
    "t10-console": {
     "CONSOLE_SESSION_KEY": "${CONSOLE_SESSION_KEY}"
    }
   }
  },
  {
   "name": "POSTGRES_PASSWORD",
   "env": {
    "t10-console": {
     "DATABASE_URL": "postgres://t10:${POSTGRES_PASSWORD}@postgres:5432/console?sslmode=disable"
    }
   }
  },
  {
   "name": "AUDIT_CONSOLE_KEY",
   "env": {
    "t10-console": {
     "GATEWAY_AUDIT_KEY": "${AUDIT_CONSOLE_KEY}"
    }
   }
  }
 ]
}
