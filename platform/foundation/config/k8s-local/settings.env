# The whole stack on this machine's Kubernetes, such as Docker Desktop's, from the same files as
# local: `make up ENV=k8s-local`. It's local in shape, so it gets local's layers, then these.
SHAPE=local
TARGET=k8s
# The kubectl context it runs in, and its namespace; nothing outside the namespace is touched.
# The namespace is <PROJECT_NAME>-k8s-local unless set.
KUBE_CONTEXT=docker-desktop
KUBE_NAMESPACE=
# 36xxx and 35xxx, so it runs beside local (38xxx, 37xxx) and the workspace's cluster (18xxx).
AUTH_PUBLIC_URL=http://localhost:36081
WORKBENCH_PUBLIC_URL=http://127.0.0.1:36083

AUTH_PORT=36081
WORKBENCH_PORT=36083
AGENT_CONTROL_PORT=36085
COLLAB_PORT=36082
KNOWLEDGE_PORT=36050
AGENT_TI_PORT=36130
LLM_GATEWAY_PORT=35200
AGENT_GATEWAY_PORT=35201
TOOLS_GATEWAY_PORT=35202
