# The foundation in the local environment: addresses browsers use, and ports published on
# 127.0.0.1. Compose reads these for ${…} values, and scripts/render.py for redirect URIs.
# 38xxx and 37xxx, so this runs beside t10-quickstart and the workspace stacks (28xxx, 27xxx).
# The issuer every service checks. Must match what browsers use to reach auth-server.
AUTH_PUBLIC_URL=http://localhost:38081
WORKBENCH_PUBLIC_URL=http://127.0.0.1:38083

AUTH_PORT=38081
WORKBENCH_PORT=38083
AGENT_CONTROL_PORT=38085
COLLAB_PORT=38082
KNOWLEDGE_PORT=38050
AGENT_TI_PORT=38130
LLM_GATEWAY_PORT=37200
AGENT_GATEWAY_PORT=37201
TOOLS_GATEWAY_PORT=37202
