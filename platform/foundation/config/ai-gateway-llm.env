# The model provider. Any OpenAI-compatible endpoint; the key is LLM_API_KEY, a secret.
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Provider models behind the aliases "smart" and "fast" in files/config.yaml.
SMART_MODEL_NAME=qwen-flash
FAST_MODEL_NAME=qwen-flash
# Speech to text: DashScope's realtime endpoint, the stt provider in files/config.yaml.
STT_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
