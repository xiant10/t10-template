# Facts about the __id__ module a deployment needs, read by the project's scripts and checks.
# Nothing here is a secret or depends on the environment (docs/module.md in the project).
# The pack format this is written in; the project's template says which it reads.
PACK_VERSION=1
MODULE_ID=__id__
SERVICE=__service__
PORT=__port__
# What it has, each adding its own wiring, secrets, OAuth clients and checks: web (a web app at a
# public address), tools (MCP tools for agents), agent (agents of its own), database (its own
# Postgres database). Drop the ones it doesn't need.
CAPABILITIES=web,tools,agent,database
# Its agents, each a folder under agents/, with runtime account agent-ti-<agent>; AGENT_TITLE_<AGENT>
# names one in the picker. What its tools need is said once, in permissions/__id__.yaml's agent
# block; the project gives it to each agent, its runtimes and the harnesses.
AGENTS=__id__
AGENT_TITLE___ID__=__Id__
# The setting that holds its web app's public address.
PUBLIC_URL_SETTING=__ID___PUBLIC_URL
