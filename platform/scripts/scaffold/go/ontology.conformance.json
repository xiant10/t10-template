{
  "tokens": { "in_scope": "person", "out_of_scope": "person:", "agent": "agent" },
  "visible": "__id__:note:n_welcome",
  "search": { "type": "note", "body": { "filter": { "property": "state", "op": "eq", "value": "open" } }, "limit": 2, "expect": 3 },
  "forbidden": { "action": "note.archive", "object": "__id__:note:n_welcome", "params": {} },
  "wrong_state": { "action": "note.edit", "object": "__id__:note:n_archived", "params": { "title": "Conformance" } },
  "apply": { "action": "note.edit", "object": "$first:note", "params": { "title": "Conformance" } }
}
