# Speech to text and text to speech both go through OpenAI, so no DashScope key is needed.
STT_PROVIDER=openai
TTS_PROVIDER=openai
# Replies come from the agents, which keep the conversation, so calls are saved with the chat.
LLM_PROVIDER=agent_pi
# The worker passes this voice to whichever TTS is on, so it must be an OpenAI voice.
QWEN_TTS_VOICE=alloy
