{
 "_comment": "The livekit component's secrets, as foundation/secrets.json.",
 "secrets": [
  {
   "name": "LIVEKIT_AGENT_SECRET",
   "generate": "hex32",
   "consumers": [
    "t10-livekit-agent",
    "auth-server account"
   ],
   "rotate": "authctl service-rotate --name=t10-livekit-agent, roll, then service-finish.",
   "rotation": "account:t10-livekit-agent",
   "env": {
    "seed": {
     "LIVEKIT_AGENT_SECRET": "${LIVEKIT_AGENT_SECRET}"
    },
    "t10-livekit-agent": {
     "AUTH_CLIENT_SECRET": "${LIVEKIT_AGENT_SECRET}"
    }
   }
  },
  {
   "name": "OPENAI_SPEECH_API_KEY",
   "generate": "provided",
   "optional": true,
   "consumers": [
    "t10-livekit-agent"
   ],
   "rotate": "As LLM_API_KEY. Empty means LLM_API_KEY is used.",
   "env": {
    "t10-livekit-agent": {
     "OPENAI_SPEECH_API_KEY": "${OPENAI_SPEECH_API_KEY:-${LLM_API_KEY}}"
    }
   }
  },
  {
   "name": "LIVEKIT_API_SECRET",
   "generate": "hex32",
   "consumers": [
    "auth-server",
    "livekit-server",
    "t10-livekit-agent"
   ],
   "rotate": "Change all three together.",
   "rotation": "replace",
   "env": {
    "livekit-server": {
     "LIVEKIT_KEYS": "${LIVEKIT_API_KEY}: ${LIVEKIT_API_SECRET}"
    },
    "t10-livekit-agent": {
     "LIVEKIT_API_SECRET": "${LIVEKIT_API_SECRET}"
    },
    "auth-server": {
     "LIVEKIT_API_SECRET": "${LIVEKIT_API_SECRET}"
    }
   }
  }
 ]
}
