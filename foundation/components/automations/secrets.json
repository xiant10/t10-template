{
 "_comment": "The automations component's secrets, as foundation/secrets.json.",
 "secrets": [
  {
   "name": "T10_AUTOMATIONS_SECRET",
   "generate": "hex32",
   "consumers": [
    "t10-automations",
    "auth-server account"
   ],
   "rotate": "authctl service-rotate --name=t10-automations, roll, then service-finish."
  }
 ]
}
