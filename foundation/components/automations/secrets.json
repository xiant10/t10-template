{
 "_comment": "The automations component's secrets, as foundation/secrets.json.",
 "secrets": [
  {
   "name": "T10_AUTOMATIONS_SECRET",
   "generate": "hex32",
   "consumers": [
    "t10-automations",
    "auth-server account"
   ],
   "rotate": "authctl service-rotate --name=t10-automations, roll, then service-finish.",
   "rotation": "account:t10-automations",
   "env": {
    "seed": {
     "T10_AUTOMATIONS_SECRET": "${T10_AUTOMATIONS_SECRET}"
    },
    "t10-automations": {
     "AUTH_CLIENT_SECRET": "${T10_AUTOMATIONS_SECRET}"
    }
   }
  },
  {
   "name": "POSTGRES_PASSWORD",
   "env": {
    "t10-automations": {
     "DATABASE_URL": "postgres://t10:${POSTGRES_PASSWORD}@postgres:5432/automations?sslmode=disable"
    }
   }
  }
 ]
}
