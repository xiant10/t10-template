PORT=9800
AGENT_CONFIG=/app/apps/assistant/config/agent.json
AGENT_DATA_DIR=/data
# Its sessions' IDs start with this, and the route document names it.
AGENT_INSTANCE_ID=agent-pi-0
AUTH_KIND=jwt
AUTH_CLIENT_ID=agent-pi
JWT_AUDIENCE=t10,agent-pi
JWT_REQUIRED_SCOPES=agent:use
JWT_TENANT_CLAIM=tid
# The gateway's aliases, mapped to provider models in ai-gateway-llm/config.yaml.
FAST_MODEL_ID=fast
SMART_MODEL_ID=smart
