{
 "_comment": "The assistant component's secrets, as foundation/secrets.json.",
 "secrets": [
  {
   "name": "AGENT_PI_SECRET",
   "generate": "hex32",
   "consumers": [
    "agent-pi",
    "auth-server account"
   ],
   "rotate": "authctl service-rotate --name=agent-pi, roll, then service-finish.",
   "rotation": "account:agent-pi",
   "env": {
    "seed": {
     "AGENT_PI_SECRET": "${AGENT_PI_SECRET}"
    },
    "agent-pi": {
     "AUTH_CLIENT_SECRET": "${AGENT_PI_SECRET}"
    }
   }
  },
  {
   "name": "GATEWAY_API_KEY",
   "env": {
    "agent-pi": {
     "LLM_API_KEY": "${GATEWAY_API_KEY}"
    }
   }
  }
 ]
}
