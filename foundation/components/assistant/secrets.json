{
 "_comment": "The assistant component's secrets, as foundation/secrets.json.",
 "secrets": [
  {
   "name": "AGENT_PI_SECRET",
   "generate": "hex32",
   "consumers": [
    "agent-pi",
    "auth-server account"
   ],
   "rotate": "authctl service-rotate --name=agent-pi, roll, then service-finish."
  }
 ]
}
