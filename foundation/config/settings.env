# The foundation's settings in every environment.
# What runs an environment: compose (built), or k8s (planned: docs/plan.md).
TARGET=compose
# The foundation components a project runs, from foundation/components/. The core always runs.
# A project picks its own in site/config/settings.env, as FOUNDATION=… without the ones it drops.
FOUNDATION=assistant,livekit,console,automations
# Where `make release` pushes the modules built from src/, such as ghcr.io/<owner>. A project
# sets it in site/config/settings.env; the template has none.
IMAGE_REGISTRY=
