# Takes calls that name no agent.
DEFAULT_AGENT=ti
# Its sessions' IDs start with this, and ai-gateway-agent's routes name it.
AGENT_INSTANCE_ID=agent-ti-0
JWT_AUDIENCE=t10,agent-ti
JWT_REQUIRED_SCOPES=agent:use
# The gateway's alias, mapped to a provider model in ai-gateway-llm/files/config.yaml.
CHAT_MODEL_ID=fast
