# Every server environment (dev, prod, and any built on them): what each project must decide.
# Set each in site/config/<env>/settings.env; `make check` fails while any value is still TODO.
# Where `make deploy` puts the bundle: an ssh destination, and a folder on that host.
DEPLOY_HOST=TODO
DEPLOY_DIR=TODO
# Public addresses, each its own host. Caddy serves them with TLS (foundation/public.json).
AUTH_PUBLIC_URL=TODO
WORKBENCH_PUBLIC_URL=TODO
# Optional: the address Let's Encrypt writes to about certificates.
ACME_EMAIL=
