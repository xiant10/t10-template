# modules/<id>/src/ holds each module's source. A module built in this project is committed there;
# one in a repo of its own is cloned there by `make clone`, which keeps it out of git in .git/info/exclude.

# Written by scripts, never edited.
/generated/

# Backups copied off a host by `make backup-pull`: encrypted, but never committed.
/backups/

# Decrypted secrets must never be committed.
*.dec
*.dec.*
.env

# Plain-text secrets, per checkout. Only the SOPS-encrypted <env>.enc.env are committed.
/site/secrets/*.env
!/site/secrets/*.enc.env
__pycache__/
