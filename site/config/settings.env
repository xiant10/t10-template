# This project's own settings, in every environment. site/ is applied after foundation/ and
# modules/, so a value here overrides theirs; site/config/<env>/ overrides for one environment.
# Compose's project name: its containers, volumes and network are prefixed with it.
PROJECT_NAME=t10-template
# The foundation components this project runs. The template's list, in foundation/config/settings.env,
# is all of them: delete the ones this project doesn't need (foundation/components/README.md).
FOUNDATION=assistant,livekit,console,automations
