# Facts about the __id__ module a deployment needs, read by the project's scripts and checks.
# Nothing here is a secret or depends on the environment (docs/module.md in the project).
MODULE_ID=__id__
SERVICE=__service__
PORT=__port__
# Delegated actions and audience its agent tools need: at least the catalog's agent block.
GRANT_ACTIONS=__id__:read
GRANT_AUDIENCE=__service__
# Its accounts in auth-server: the service itself, and its agent's own runtime.
SERVICE_ACCOUNTS=__service__,agent-ti-__id__
# Its agent folder under agents/, its name in the agent picker, and its runtime account.
AGENT=__id__
AGENT_TITLE=__Id__
AGENT_RUNTIME=agent-ti-__id__
# The setting that holds its web app's public address.
PUBLIC_URL_SETTING=__ID___PUBLIC_URL
