# Facts about the __id__ module a deployment needs, read by the project's scripts and checks.
# Nothing here is a secret or depends on the environment (docs/module.md in the project).
MODULE_ID=__id__
SERVICE=__service__
PORT=__port__
# Its accounts in auth-server: the service itself, and its agent's own runtime. Each one's
# secret is its name in capitals with _SECRET, such as AGENT_TI___ID___SECRET.
SERVICE_ACCOUNTS=__service__,agent-ti-__id__
# Its agent folder under agents/, its name in the agent picker, and its runtime account. What
# its tools need is said once, in permissions/__id__.yaml's agent block; the project gives it to
# the agent, its runtimes and the harnesses.
AGENT=__id__
AGENT_TITLE=__Id__
AGENT_RUNTIME=agent-ti-__id__
# The setting that holds its web app's public address.
PUBLIC_URL_SETTING=__ID___PUBLIC_URL
